# Supabase — get these from your project: Settings → API
# https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Notes:
# - Only VITE_-prefixed vars are exposed to the client bundle (this is intended for the anon key).
# - NEVER put the service_role key here or anywhere in client code — it bypasses RLS.
# - If these are left empty, the app falls back to mock data (no backend).
